# Application
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.example
DOMAIN=your-domain.example
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
TRUST_PROXY=true
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com

# PostgreSQL (use a managed PostgreSQL URL or the included Docker Compose service)
DATABASE_URL=postgresql://apexcode:change-this-password@db:5432/apexcode
DATABASE_SSL=false

# Telegram bot: create a bot with @BotFather; set TELEGRAM_ADMIN_CHAT_ID to your private admin chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Stripe Checkout (use test keys first; set the Price ID from Stripe Dashboard)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
